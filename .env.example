GOALCOACH_DATABASE_URL=sqlite:///./goalcoach.db
GOALCOACH_CONTENT_DATABASE_URL=sqlite:///./data/database1/goalcoach_hsk1_learning.db
GOALCOACH_ENABLE_PREREQUISITES=false

# Supabase learner persistence. Set the password from Supabase Project Settings > Database.
# When this is set and GOALCOACH_DATABASE_URL is left at its SQLite default, the API uses Postgres.
GOALCOACH_SUPABASE_URL=https://yiklbqnojmijxtvlryqr.supabase.co
GOALCOACH_SUPABASE_DB_PASSWORD=
GOALCOACH_SUPABASE_DB_USER=postgres
# Optional for projects using a pooler or a custom database host.
# GOALCOACH_SUPABASE_DB_HOST=aws-0-eu-west-2.pooler.supabase.com
# GOALCOACH_SUPABASE_DB_PORT=6543

# Primary hosted model
GOALCOACH_LLM_BASE_URL=https://openrouter.ai/api/v1
GOALCOACH_LLM_API_KEY=your-api-key-here
GOALCOACH_LLM_MODEL=inclusionai/ling-3.0-flash-fin
GOALCOACH_LLM_TIMEOUT_SECONDS=30
GOALCOACH_LLM_MAX_RETRIES=2
GOALCOACH_OFFLINE_LLM_FALLBACK=false

# Optional local fallback via Ollama's OpenAI-compatible endpoint
GOALCOACH_FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
GOALCOACH_FALLBACK_LLM_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M
GOALCOACH_ENABLE_OLLAMA_FALLBACK=false
