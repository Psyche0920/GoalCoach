GOALCOACH_ENVIRONMENT=development
GOALCOACH_DATABASE_URL=sqlite:///./goalcoach.db
GOALCOACH_CONTENT_DATABASE_URL=sqlite:///./data/database1/goalcoach_hsk1_learning.db
GOALCOACH_PLANNING_ITEM_MINUTES=5
GOALCOACH_LLM_BASE_URL=https://openrouter.ai/api/v1
GOALCOACH_LLM_API_KEY=
GOALCOACH_LLM_MODEL=
GOALCOACH_LLM_TIMEOUT_SECONDS=30
GOALCOACH_LLM_MAX_RETRIES=2
GOALCOACH_LLM_MAX_COST_USD_PER_WEEK=50
GOALCOACH_ENABLE_BACKGROUND_UPDATES=true
GOALCOACH_ENABLE_VECTOR_RETRIEVAL=false
GOALCOACH_ENABLE_LANGGRAPH=false
# Senior-review default for local fallback (Ollama's OpenAI-compatible endpoint):
GOALCOACH_FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
GOALCOACH_FALLBACK_LLM_MODEL=unsloth/gemma-4-12b-it-GGUF
