GOALCOACH_DATABASE_URL=sqlite:///./goalcoach.db
GOALCOACH_CONTENT_DATABASE_URL=sqlite:///./data/database1/goalcoach_hsk1_learning.db
GOALCOACH_ENABLE_PREREQUISITES=false

# LLM for open-ended explanations, grading, and Jev fallback.
GOALCOACH_LLM_BASE_URL=https://openrouter.ai/api/v1
GOALCOACH_LLM_API_KEY=your-openrouter-api-key
# Primary model ID; use an ID supported by the service at GOALCOACH_LLM_BASE_URL.
GOALCOACH_LLM_MODEL=openai/gpt-6.1-sol
# Output format: auto accepts tools or text JSON; text/tool restrict final output.
GOALCOACH_LLM_OUTPUT_MODE=auto
GOALCOACH_LLM_TIMEOUT_SECONDS=30
GOALCOACH_LLM_MAX_RETRIES=2
GOALCOACH_OFFLINE_LLM_FALLBACK=false

# Optional local fallback via Ollama's OpenAI-compatible endpoint
GOALCOACH_FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
GOALCOACH_FALLBACK_LLM_MODEL=hf.co/unsloth/gemma-4-E4B-it-GGUF:Q4_K_M
GOALCOACH_ENABLE_OLLAMA_FALLBACK=false

# Finite course, daily-plan, exercise, teaching-card, and strategy decisions via OpenRouter.
# Use an OpenRouter key from https://openrouter.ai/settings/keys, then restart.
GOALCOACH_JEV_ENABLED=true
GOALCOACH_JEV_API_KEY=your-openrouter-api-key
GOALCOACH_JEV_BASE_URL=https://openrouter.ai/api/v1
GOALCOACH_JEV_MODEL=typesafe/jev-1.13
GOALCOACH_JEV_TIMEOUT_SECONDS=10
