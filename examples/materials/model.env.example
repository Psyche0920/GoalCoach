# Separate provider settings. Copy to .materials.env (ignored by Git) and fill locally.
# Do not put real credentials into this example file.
MATERIALS_BASE_URL=https://api.openai.com/v1
MATERIALS_MODEL=
MATERIALS_API_KEY=
MATERIALS_TIMEOUT_SECONDS=90
MATERIALS_REQUEST_LIMIT=30
# Optional rates from your provider. Set both or leave both absent.
# MATERIALS_INPUT_USD_PER_MILLION=1.00
# MATERIALS_OUTPUT_USD_PER_MILLION=4.00
